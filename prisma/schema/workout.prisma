// Workout & diet plan models

model WorkoutPlan {
  id          String    @id @default(uuid())
  memberId    String
  trainerId   String?
  title       String
  description String?
  exercises   Json?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id])

  @@map("workout_plans")
}

model DietPlan {
  id          String    @id @default(uuid())
  memberId    String
  title       String
  description String?
  meals       Json?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("diet_plans")
}
